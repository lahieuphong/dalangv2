# DALANG V2 · production config for Apache / LiteSpeed (https://dalangv2.hongvan.net)
# Every block is guarded with <IfModule>, so a host missing a module never returns a 500.

Options -Indexes
DirectoryIndex index.html

# The camera only works on HTTPS. The X-Forwarded-Proto check prevents redirect
# loops behind proxies such as Cloudflare.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# MediaPipe needs .wasm served as application/wasm.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .task
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
  # The CDN hosts are only used as a fallback if the local MediaPipe files fail to load.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' https://cdn.jsdelivr.net https://storage.googleapis.com; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
  # Enable once HTTPS is confirmed working on the domain:
  # Header always set Strict-Transport-Security "max-age=31536000"

  # The page itself always revalidates so new deploys show up immediately.
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # MediaPipe runtime and hand model: large and rarely changed.
  <FilesMatch "\.(wasm|task)$|^vision_wasm_.*\.js$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
